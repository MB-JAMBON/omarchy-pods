{
  "schemaVersion": 1,
  "id": "io.github.mb-jambon.omapods",
  "name": "AirPods",
  "version": "1.5.0",
  "author": "MB-JAMBON",
  "license": "MIT",
  "description": "AirPods in the Omarchy bar: per-pod and case battery, listening mode, adaptive noise level, conversation awareness, one-bud ANC and ear detection.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "AirPods",
    "description": "Battery for each pod and the case, plus the listening controls macOS keeps in its Sound menu.",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "hideWhenDisconnected": false,
      "ctlPath": "",
      "showConnectionCard": true,
      "animateConnectionCard": true
    },
    "schema": [
      {
        "key": "hideWhenDisconnected",
        "type": "boolean",
        "label": "Hide the icon when no AirPods are connected",
        "defaultValue": false
      },
      {
        "key": "ctlPath",
        "type": "path",
        "label": "Path to librepods-ctl",
        "description": "Leave empty to find librepods-ctl on PATH.",
        "defaultValue": ""
      },
      {
        "key": "showConnectionCard",
        "type": "boolean",
        "label": "Show card when AirPods connect",
        "defaultValue": true
      },
      {
        "key": "animateConnectionCard",
        "type": "boolean",
        "label": "Animate the connection card",
        "defaultValue": true
      }
    ]
  }
}
